// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AssetType {
  IMAGE
  VIDEO
  SOUND
}

enum AssetStatus {
  ACTIVE
  TAKEN_DOWN
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

// Creators connect a wallet; no separate auth account exists for visitors.
model User {
  id           String   @id @default(cuid())
  walletAddress String  @unique
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  assets       Asset[]
  reports      Report[]
  takedowns    TakedownLog[] @relation("TakedownActor")
}

// Every public asset comes from a user upload plus a signed rights declaration.
model Asset {
  id            String      @id @default(cuid())
  title         String
  type          AssetType
  filePath      String
  thumbnailPath String?
  status        AssetStatus @default(ACTIVE)
  featured      Boolean     @default(false)
  downloadCount Int         @default(0)
  createdAt     DateTime    @default(now())

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id])

  declaration Declaration?
  reports     Report[]
  takedowns   TakedownLog[]
}

// Mandatory rights declaration captured at upload time (WAJIB — see CLAUDE.md).
model Declaration {
  id            String   @id @default(cuid())
  ownsRights    Boolean
  agreedToTos   Boolean
  agreedAt      DateTime @default(now())

  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id])
}

// Visitor-facing report on any asset.
model Report {
  id        String       @id @default(cuid())
  reason    String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id])
}

// Paper trail for every admin takedown action (WAJIB — see CLAUDE.md).
model TakedownLog {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  actorId String
  actor   User   @relation("TakedownActor", fields: [actorId], references: [id])
}
