# SQLite locally; swap to a Postgres/Supabase connection string at deploy.
DATABASE_URL="file:./dev.db"

# Comma-separated wallet addresses. Source of truth for admin identity —
# see CLAUDE.md PERAN & AKSES. Never derived from the database alone.
ADMIN_WALLETS=""

# Random secret used to sign session cookies (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# WalletConnect Cloud project ID (https://cloud.walletconnect.com) — needed
# for mobile/WalletConnect wallets in ConnectKit. Injected wallets (e.g.
# MetaMask browser extension) still work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Anthropic API key for The Librarian chat (server-side only, never exposed
# to the client). Get one at https://console.anthropic.com. Without this
# set, /api/librarian returns 503 and the chat widget shows that error —
# everything else on the site works fine without it.
ANTHROPIC_API_KEY=""

# Public contact address for formal copyright/legal notices, shown on
# /tos. The in-app report button is the primary moderation path — this is
# just a fallback for notices that need to go through email. Optional; if
# unset, the ToS page just says a contact address isn't configured yet.
COPYRIGHT_EMAIL=""
