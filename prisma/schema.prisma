// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AssetType {
  IMAGE
  VIDEO
  SOUND
}

enum AssetStatus {
  ACTIVE
  TAKEN_DOWN
  PENDING_REVIEW
}

enum UserRole {
  VISITOR_CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ReportReason {
  COPYRIGHT
  ILLEGAL
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum TakedownAction {
  TAKEDOWN
  RESTORE
  DELETE
  BAN_UPLOADER
  UNBAN_UPLOADER
}

// Wallet address is the identity — no separate account system for
// creators/admins. `role` is a cache: the source of truth for admin is the
// ADMIN_WALLETS env var (see CLAUDE.md), never the DB alone.
model User {
  walletAddress String     @id
  role          UserRole   @default(VISITOR_CREATOR)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())

  assets       Asset[]
  declarations UploadDeclaration[]
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  assets Asset[]
}

// Every public asset is a user upload (never platform-authored — see
// CLAUDE.md POSISI LEGAL #1) and, for now, requires a wallet + declaration.
// `uploaderWallet` is nullable ahead of a possible future anonymous-upload
// path, but application code must treat it as required today.
model Asset {
  id            String      @id @default(cuid())
  title         String
  description   String
  type          AssetType
  fileUrl       String
  thumbnailUrl  String?
  fileSize      Int
  duration      Int?
  status        AssetStatus @default(ACTIVE)
  isOriginal    Boolean     @default(false)
  featured      Boolean     @default(false)
  downloadCount Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  uploaderWallet String?
  uploader        User?   @relation(fields: [uploaderWallet], references: [walletAddress])

  tags        Tag[]
  declaration UploadDeclaration?
  reports     Report[]
  takedowns   TakedownLog[]
}

// Paper trail proving the uploader agreed to the rights declaration + ToS
// at upload time (WAJIB — see CLAUDE.md POSISI LEGAL #2). Never mutated.
model UploadDeclaration {
  id              String   @id @default(cuid())
  declarationText String
  tosVersion      String
  acceptedAt      DateTime @default(now())
  ipHash          String

  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id])

  uploaderWallet String
  uploader       User   @relation(fields: [uploaderWallet], references: [walletAddress])
}

// Visitor-facing report on an asset. No wallet required to report.
model Report {
  id              String       @id @default(cuid())
  reporterContact String?
  reason          ReportReason
  detail          String
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  // Admin's short reason for dismissing — only set on the Dismiss path.
  // Takedown-from-report's reason lives on the linked TakedownLog row
  // instead (via `takedowns`), so it isn't duplicated here.
  reviewNote      String?

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  takedowns TakedownLog[]
}

// Append-only paper trail for every admin action (WAJIB — see CLAUDE.md
// POSISI LEGAL #4/#5). Application code must only ever INSERT here —
// never update or delete a row.
model TakedownLog {
  id        String         @id @default(cuid())
  actionBy  String
  action    TakedownAction
  reason    String
  createdAt DateTime       @default(now())

  // Nullable: a user-level BAN_UPLOADER/UNBAN_UPLOADER action isn't
  // inherently about one specific asset (e.g. unbanning someone, or
  // banning a user who has zero uploads yet). Ban's cascade still writes
  // one row per affected asset (assetId set) alongside `targetWallet`.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  // The wallet a BAN_UPLOADER/UNBAN_UPLOADER action targets — distinct
  // from `actionBy`, which is always the admin performing the action.
  targetWallet String?

  relatedReportId String?
  relatedReport   Report? @relation(fields: [relatedReportId], references: [id])
}
