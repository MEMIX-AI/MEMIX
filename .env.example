# SQLite locally; swap to a Postgres/Supabase connection string at deploy.
DATABASE_URL="file:./dev.db"

# Comma-separated wallet addresses. Source of truth for admin identity —
# see CLAUDE.md PERAN & AKSES. Never derived from the database alone.
ADMIN_WALLETS=""

# Random secret used to sign session cookies (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# WalletConnect Cloud project ID (https://cloud.walletconnect.com) — needed
# for mobile/WalletConnect wallets in ConnectKit. Injected wallets (e.g.
# MetaMask browser extension) still work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Anthropic API key for The Librarian chat (server-side only, never exposed
# to the client). Get one at https://console.anthropic.com. Without this
# set, /api/librarian returns 503 and the chat widget shows that error —
# everything else on the site works fine without it.
ANTHROPIC_API_KEY=""

# Public contact address for formal copyright/legal notices, shown on
# /tos. The in-app report button is the primary moderation path — this is
# just a fallback for notices that need to go through email. Optional; if
# unset, the ToS page just says a contact address isn't configured yet.
COPYRIGHT_EMAIL=""

# Virtuals compute endpoint (https://compute.virtuals.io/v1, OpenAI-
# compatible /chat/completions) — powers the AI-generated verdict feature
# (lib/verdict-generator.ts), admin-triggered only, never on upload. Get a
# key from Virtuals; runs on free inference credit, so keep an eye on
# usage. Without this set, verdict generation fails cleanly (logged,
# nothing written) — everything else on the site works fine without it.
VIRTUALS_API_KEY=""

# Primary + fallback model for verdict generation. If the primary fails
# (down, rate-limited, etc.) the fallback is tried once before giving up.
VIRTUALS_MODEL="claude-opus-4-7-fast"
VIRTUALS_MODEL_FALLBACK="moonshotai-kimi-k3"

# Max real LLM calls per UTC day for verdict generation, across every
# admin trigger combined (see VerdictGenerationLog) — protects the
# Virtuals credit budget from being exhausted by a big batch run.
VERDICT_DAILY_CAP="50"
