// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AssetType {
  IMAGE
  VIDEO
  SOUND
}

enum AssetStatus {
  ACTIVE
  TAKEN_DOWN
  PENDING_REVIEW
  // Creator saved the form but hasn't published — invisible everywhere
  // (not just "unlisted": it's excluded by the same status:"ACTIVE" check
  // every public/access query already uses, so it needed no extra
  // enforcement code, just this value). Only reachable from /my-uploads
  // by the owner, who flips it to ACTIVE via the publish action.
  DRAFT
}

// Public: listed everywhere + reachable by link. Unlisted: never appears
// in library/search/trending/home, but the direct /asset/:id link still
// works for anyone who has it (no login needed — same "no login to
// browse" policy as public assets). Private: only the uploader can reach
// it at all, even via direct link — see lib/asset-visibility.ts.
enum AssetVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

// The "verdict" taxonomy from /docs' documented target shape (MV—005) —
// distinct from AssetStatus above, which is a moderation state
// (ACTIVE/TAKEN_DOWN/PENDING_REVIEW). Naming this VerdictStatus (not
// `status`) avoids colliding with Asset.status; the API layer maps it to
// the externally-documented `status` JSON key instead.
enum VerdictStatus {
  EMERGING
  LIVE
  PEAKING
  FADING
  DATED
  DEAD
}

enum UserRole {
  VISITOR_CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ReportReason {
  COPYRIGHT
  ILLEGAL
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum TakedownAction {
  TAKEDOWN
  RESTORE
  DELETE
  BAN_UPLOADER
  UNBAN_UPLOADER
}

// Only tier that exists today — every key is free while the programmatic
// API is a foundation, not yet monetized (see CLAUDE.md: machines pay,
// humans don't, but that's a later phase). Paid tiers are TODO.
enum ApiKeyTier {
  FREE_DEV
}

// Wallet address is the identity — no separate account system for
// creators/admins. `role` is a cache: the source of truth for admin is the
// ADMIN_WALLETS env var (see CLAUDE.md), never the DB alone.
model User {
  walletAddress String     @id
  role          UserRole   @default(VISITOR_CREATOR)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())

  // Public profile fields (all nullable) — none of these are identity,
  // walletAddress stays the only thing that's ever looked up by or
  // trusted for auth. Every page renders a fallback when null (shortened
  // wallet in place of username, no bio block, etc.) rather than treating
  // an unfilled profile as an error state. avatarUrl is either a bare
  // storage key (uploaded photo — resolve via lib/storage.ts same as
  // Asset thumbnails) or a raw http(s) URL (pasted link) — see
  // lib/asset-urls.ts#isStorageKey for the same pattern applied to assets.
  username  String?
  avatarUrl String?
  xHandle   String?
  bio       String?

  assets       Asset[]
  declarations UploadDeclaration[]
  apiKey       ApiKey?
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  assets Asset[]
}

// Every public asset is a user upload (never platform-authored — see
// CLAUDE.md POSISI LEGAL #1) and, for now, requires a wallet + declaration.
// `uploaderWallet` is nullable ahead of a possible future anonymous-upload
// path, but application code must treat it as required today.
model Asset {
  id            String          @id @default(cuid())
  title         String
  description   String
  type          AssetType
  fileUrl       String
  thumbnailUrl  String?
  fileSize      Int
  duration      Int?
  status        AssetStatus     @default(ACTIVE)
  visibility    AssetVisibility @default(PUBLIC)
  isOriginal    Boolean         @default(false)
  featured      Boolean         @default(false)
  downloadCount Int             @default(0)
  // Real, tracked counters — viewCount increments on a genuine detail-page
  // view (deduped per browser+IP per rolling 24h window, see
  // app/api/assets/[id]/view/route.ts + AssetViewer below), and likeCount
  // is maintained in lockstep with AssetLike rows (every write to either
  // happens in the same transaction — see app/api/assets/[id]/like/
  // route.ts). Neither is ever hand-set/faked.
  viewCount     Int             @default(0)
  likeCount     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Editorial "verdict" fields (MV—005) — all nullable, filled either by an
  // admin directly (components/admin/VerdictEditor.tsx) or by the AI
  // generator (lib/verdict-generator.ts, admin-triggered only — see
  // VerdictGenerationLog below). Every pre-existing asset gets NULL here
  // automatically; the API layer reports that as "unverdicted", never as
  // an empty/missing field.
  verdictStatus VerdictStatus?
  peaked        String?
  worksWhen     String?
  avoidWhen     String?

  uploaderWallet String?
  uploader       User?   @relation(fields: [uploaderWallet], references: [walletAddress])

  tags                  Tag[]
  declaration           UploadDeclaration?
  reports               Report[]
  takedowns             TakedownLog[]
  downloadEvents        DownloadEvent[]
  likes                 AssetLike[]
  viewers               AssetViewer[]
  verdictGenerationLogs VerdictGenerationLog[]
}

// One row per actual outbound call to the Virtuals LLM endpoint attempting
// to generate a verdict — every attempt, success or failure, gets logged
// here. This is both the "no claim without receipt" audit trail (an admin
// can see exactly which model produced a given verdict and what "vibe" it
// reasoned from) and the source of truth for the daily call cap: counting
// rows created since UTC midnight tells the generator how many real calls
// have already been spent today, so a run of failures can't quietly blow
// past the budget just because none of them wrote a verdict.
model VerdictGenerationLog {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  success      Boolean
  // Model that actually answered (primary or fallback) — null if the call
  // never got a response at all (e.g. both models failed to connect).
  model        String?
  // The LLM's own one/two-word read on the meme's genre — logged for
  // audit even though it isn't written to any Asset column (see
  // lib/verdict-generator.ts for why "vibe" doesn't get force-added as a
  // tag).
  vibe         String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// TTL cache for on-chain $MIX balance reads (lib/mix-token.ts) — a fresh
// balanceOf call hits ROBINHOOD_RPC_URL, which is real network I/O with
// real (if small) cost and latency; caching per wallet for a few minutes
// (MIX_BALANCE_CACHE_TTL_SECONDS) means a wallet clicking around the site
// doesn't trigger a fresh RPC call on every single request. Not a
// rate-limit table — see LibrarianPublicUsageLog for that.
model MixBalanceCache {
  walletAddress String   @id
  // Human-readable token count (already divided by the token's real
  // on-chain decimals() — never assumed to be 18), not raw base units.
  balance       Float
  checkedAt     DateTime @default(now())
}

// One row per actual attempted public Librarian verdict call (see
// app/api/librarian/verdict/[assetId]/route.ts) — deliberately only
// written when a real LLM call was spent (success or failure), never for
// a cache-hit (asset already verdicted), a not-found asset, or a request
// blocked by the admin feature's own shared VERDICT_DAILY_CAP — none of
// those cost any credit, so none of them should burn a wallet's daily
// quota. This table is the source of truth for both FREE_DAILY_QUOTA/
// HOLDER_DAILY_QUOTA (per wallet) and GLOBAL_DAILY_CAP (everyone
// combined), both counted from real rows since UTC midnight, never
// assumed. assetId is a plain field, not a hard relation — this is an
// audit/rate-limit log that should outlive the asset it referenced, not
// cascade-delete with it.
model LibrarianPublicUsageLog {
  id            String   @id @default(cuid())
  walletAddress String
  // "FREE" | "HOLDER" at the moment of this call — plain string (not a
  // Prisma enum) since the tier model itself is env-config-driven
  // (MIN_MIX_HOLD), not a fixed domain concept.
  tier          String
  assetId       String?
  success       Boolean
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([walletAddress, createdAt])
  @@index([createdAt])
}

// Paper trail proving the uploader agreed to the rights declaration + ToS
// at upload time (WAJIB — see CLAUDE.md POSISI LEGAL #2). Never mutated.
model UploadDeclaration {
  id              String   @id @default(cuid())
  declarationText String
  tosVersion      String
  acceptedAt      DateTime @default(now())
  ipHash          String

  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id])

  uploaderWallet String
  uploader       User   @relation(fields: [uploaderWallet], references: [walletAddress])
}

// Visitor-facing report on an asset. No wallet required to report.
model Report {
  id              String       @id @default(cuid())
  reporterContact String?
  reason          ReportReason
  detail          String
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  // Admin's short reason for dismissing — only set on the Dismiss path.
  // Takedown-from-report's reason lives on the linked TakedownLog row
  // instead (via `takedowns`), so it isn't duplicated here.
  reviewNote      String?

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  takedowns TakedownLog[]
}

// Append-only paper trail for every admin action (WAJIB — see CLAUDE.md
// POSISI LEGAL #4/#5). Application code must only ever INSERT here —
// never update or delete a row.
model TakedownLog {
  id        String         @id @default(cuid())
  actionBy  String
  action    TakedownAction
  reason    String
  createdAt DateTime       @default(now())

  // Nullable: a user-level BAN_UPLOADER/UNBAN_UPLOADER action isn't
  // inherently about one specific asset (e.g. unbanning someone, or
  // banning a user who has zero uploads yet). Ban's cascade still writes
  // one row per affected asset (assetId set) alongside `targetWallet`.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  // The wallet a BAN_UPLOADER/UNBAN_UPLOADER action targets — distinct
  // from `actionBy`, which is always the admin performing the action.
  targetWallet String?

  relatedReportId String?
  relatedReport   Report? @relation(fields: [relatedReportId], references: [id])
}

// Foundation for the programmatic-access layer (CLAUDE.md: "manusia
// gratis, mesin bayar" — this is the free/dev groundwork, not the paid
// layer itself). One key per wallet for now — `ownerWallet` is unique, so
// "generate" is really "generate-or-replace". Only the hash is ever
// stored; the raw key is shown once at creation and never retrievable
// again, same convention as GitHub/Stripe-style tokens.
model ApiKey {
  id           String     @id @default(cuid())
  keyHash      String     @unique
  ownerWallet  String     @unique
  tier         ApiKeyTier @default(FREE_DEV)
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  requestCount Int        @default(0)

  owner User @relation(fields: [ownerWallet], references: [walletAddress])
}

// Per-download log, powering a real rolling-window "trending" calc (see
// lib/assets.ts#getTrendingAssets) — Asset.downloadCount alone can only
// answer "downloaded ever," never "downloaded in the last 7 days." Kept
// as its own table rather than added onto Asset so the cheap lifetime
// counter stays cheap, and this one can grow/get pruned independently.
//
// Retention: nothing here auto-prunes yet — see docs/deploy-checklist.md
// for the retention note (rows past the 7-day trending window have no
// product use; suggested prune threshold is ~90 days, kept longer than
// 7 purely as a debugging/analytics safety margin).
model DownloadEvent {
  id        String   @id @default(cuid())
  assetId   String
  createdAt DateTime @default(now())
  ipHash    String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
}

// One row per (asset, browser) — no wallet/login required to like. Identity
// is a random id the browser generates once and keeps in localStorage (see
// components/LikeButton.tsx), sent as `clientId` on every like/unlike call.
// This is intentionally a lightweight, spoofable identity (clearing
// localStorage gets you another like) — the like route also rate-limits
// new likes per IP as a backstop, matching "dedup ringan + rate-limit per
// IP" rather than trying to make liking un-gameable. The unique composite
// key is what actually prevents a double-like from the same browser.
// Asset.likeCount is a denormalized counter kept in sync with this table's
// row count via the same transaction on every like/unlike (see
// app/api/assets/[id]/like/route.ts) rather than COUNT()'d on every read,
// since cards/listings need the count cheaply and often.
model AssetLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  clientId String

  @@unique([assetId, clientId])
}

// One row per (asset, IP) ever — NOT one row per view. Tracks only the
// most recent counted view per pair so the view route can answer "has this
// IP already counted a view for this asset within the rolling 24h window"
// with a single row lookup, then upserts `viewedAt` forward when it counts
// a new one. This is the actual rolling-window enforcement (per CLIENT
// instruction: "24 jam rolling", not a fixed calendar window) — a
// client-side localStorage check (components/ViewTracker.tsx) is the fast
// path that avoids the network round-trip on repeat visits, this table is
// the source of truth.
model AssetViewer {
  assetId  String
  ipHash   String
  viewedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, ipHash])
}

// DB-backed fixed-window rate limiting, shared across instances — replaces
// an earlier in-memory Map that silently didn't work under serverless
// deploy (each invocation can get a fresh process, so in-memory state
// isn't reliably shared between requests). `key` bakes the window start
// into itself (e.g. "librarian:1.2.3.4:1784700000000"), so a plain atomic
// upsert-increment is enough — no read-then-compare-then-write race.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime
}
